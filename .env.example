# ---------------------------------------------------------------------------
# DigiCon — client environment
#
# Copy to `.env` and fill in. Never commit `.env`.
#
# Only VITE_-prefixed variables reach the browser bundle. Anything here is
# PUBLIC. Never put a service-role key, PayPal client secret, or wallet signing
# key in this file — those belong in Supabase Edge Function secrets.
# ---------------------------------------------------------------------------

# Required — the app renders a configuration screen without these.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Canonical origin used to build shareable card URLs and QR codes.
# Defaults to https://digicon.cards when unset.
VITE_PUBLIC_APP_URL=http://localhost:5173

# PayPal public client id. Optional: pricing falls back to a sign-in prompt
# when absent. The client SECRET is a server-side value and must never appear
# with a VITE_ prefix.
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_ENVIRONMENT=sandbox

# ---------------------------------------------------------------------------
# Server-side secrets — set with `supabase secrets set`, NOT in this file.
# Listed for reference only.
# ---------------------------------------------------------------------------
#
#   SUPABASE_SERVICE_ROLE_KEY
#   PUBLIC_APP_URL
#   WALLET_ALLOWED_ORIGINS              comma-separated, e.g. https://digicon.cards
#
#   PAYPAL_CLIENT_ID
#   PAYPAL_CLIENT_SECRET
#   PAYPAL_ENVIRONMENT                  sandbox | production
#   PAYPAL_WEBHOOK_ID
#   PAYPAL_STARTER_PLAN_ID
#   PAYPAL_GROWTH_PLAN_ID
#   PAYPAL_ENTERPRISE_PLAN_ID
#
#   APPLE_PASS_TYPE_IDENTIFIER
#   APPLE_TEAM_IDENTIFIER
#   APPLE_CERTIFICATE_PEM
#   APPLE_PRIVATE_KEY_PEM
#   APPLE_WWDR_CERTIFICATE_PEM
#
#   GOOGLE_WALLET_ISSUER_ID
#   GOOGLE_WALLET_CLASS_ID
#   GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL
#   GOOGLE_WALLET_PRIVATE_KEY
